<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Platinum_Gym_System</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Estilos propios -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            margin: 0;
            padding: 0;
            display: flex;
            min-height: 100vh;
            background-color: #f4f6f9;
        }

        /* Sidebar */
        .sidebar {
            width: 250px;
            background: #0d47a1;
            color: white;
            display: flex;
            flex-direction: column;
            padding: 20px 0;
            position: fixed;
            top: 0;
            bottom: 0;
        }

            .sidebar .brand {
                font-size: 1.5rem;
                text-align: center;
                font-weight: bold;
                margin-bottom: 30px;
            }

            .sidebar a {
                padding: 14px 25px;
                display: flex;
                align-items: center;
                color: white;
                text-decoration: none;
                font-size: 1.1rem;
            }

                .sidebar a:hover {
                    background: rgba(255, 255, 255, 0.15);
                }

            .sidebar i {
                margin-right: 12px;
            }

        /* Contenido principal */
        .content {
            margin-left: 250px;
            width: calc(100% - 250px);
            padding: 25px;
        }

        footer {
            margin-left: 250px;
        }
    </style>
</head>

<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="brand">
            <i class="fas fa-dumbbell me-2"></i> Platinum Gym
        </div>

        @* Admin *@
        @if (User.IsInRole("1"))
        {
            <a asp-controller="Products" asp-action="Index">
                <i class="fas fa-box"></i> Productos
            </a>
            <a asp-controller="Users" asp-action="Index">
                <i class="fas fa-users-cog"></i> Usuarios
            </a>
            <a asp-controller="Plans" asp-action="Index">
                <i class="fas fa-clipboard-list"></i> Planes
            </a>
            <a asp-controller="Client" asp-action="Index">
                <i class="fas fa-user"></i> Clientes
            </a>
            <a asp-controller="Sales" asp-action="Index">
                <i class="fas fa-shopping-cart"></i> Ventas
            </a>
            <a asp-controller="Reports" asp-action="Index">
                <i class="fas fa-shopping-cart"></i> Reportes
            </a>
        }

        @* Vendedor *@
        @if (User.IsInRole("2"))
        {
            <a asp-controller="Client" asp-action="Index">
                <i class="fas fa-user"></i> Clientes
            </a>
            <a asp-controller="Sales" asp-action="Index">
                <i class="fas fa-shopping-cart"></i> Ventas
            </a>
        }

        <a asp-controller="Users" asp-action="Logout">
            <i class="fas fa-sign-out-alt"></i> Cerrar sesión
        </a>
    </div>

    <!-- Contenido -->
    <div class="content">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="border-top footer text-muted text-center py-3">
        <div class="container">
            © 2025 - Platinum_Gym_System
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
