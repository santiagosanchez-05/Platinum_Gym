@model IEnumerable<Platinum_Gym_System.Models.Product>

@{
    ViewData["Title"] = "Gestión de Productos";
}

<link rel="stylesheet" href="~/css/ProductStyleSheet.css" />

<div class="products-page">

    <div class="products-header">
        <h1 class="products-title">
            <i class="fas fa-dumbbell"></i>
            Products of Gym
        </h1>

        <a asp-action="Create" class="btn-create">
            <i class="fas fa-plus-circle"></i>
            New Product
        </a>
    </div>

    <div class="products-content">
        <div class="table-wrapper">
            <table class="products-table">
                <thead>
                    <tr>
                        <th class="col-name">
                            <i class="fas fa-tag"></i>
                            @Html.DisplayNameFor(model => model.ProductName)
                        </th>
                        <th class="col-category">
                            <i class="fas fa-folder"></i>
                            @Html.DisplayNameFor(model => model.Category)
                        </th>
                        <th class="col-price">
                            <i class="fas fa-dollar-sign"></i>
                            @Html.DisplayNameFor(model => model.Price)
                        </th>
                        <th class="col-stock">
                            <i class="fas fa-boxes"></i>
                            @Html.DisplayNameFor(model => model.StockQuantity)
                        </th>
                        <th class="col-image">
                            <i class="fas fa-image"></i>
                            Imagen
                        </th>
                        <th class="col-actions">
                            <i class="fas fa-cogs"></i>
                            Actions
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="product-row">
                            <td class="product-name">
                                <div class="name-wrapper">
                                    <i class="fas fa-cube"></i>
                                    @Html.DisplayFor(modelItem => item.ProductName)
                                </div>
                            </td>

                            <td class="product-category">
                                <span class="category-badge category-@item.Category.ToLower()">
                                    @Html.DisplayFor(modelItem => item.Category)
                                </span>
                            </td>

                            <td class="product-price">
                                <span class="price-value">
                                    $@Html.DisplayFor(modelItem => item.Price)
                                </span>
                            </td>

                            <td class="product-stock">
                                <div class="stock-indicator">
                                    <span class="stock-value @GetStockClass(item.StockQuantity)">
                                        @Html.DisplayFor(modelItem => item.StockQuantity)
                                    </span>
                                    <div class="stock-bar">
                                        <div class="stock-fill @GetStockClass(item.StockQuantity)"
                                             style="width: @GetStockPercentage(item.StockQuantity)%"></div>
                                    </div>
                                </div>
                            </td>

                            <td class="product-actions">
                                <div class="actions-container">
                                    <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn-action btn-edit">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>

                                    <a asp-action="Details" asp-route-id="@item.ProductId" class="btn-action btn-details">
                                        <i class="fas fa-eye"></i> Details
                                    </a>

                                    <a asp-action="Delete" asp-route-id="@item.ProductId" class="btn-action btn-delete">
                                        <i class="fas fa-trash-alt"></i> Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


@functions {
    private string GetStockClass(int stock)
    {
        return stock <= 5 ? "critical" : stock <= 15 ? "warning" : "healthy";
    }

    private int GetStockPercentage(int stock)
    {
        return Math.Min(stock * 3, 100);
    }
}
