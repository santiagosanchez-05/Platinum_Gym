@model User
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Member Check-In</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/LoginStyleSheet.css" />
</head>

<body>
    <div class="main-container d-flex align-items-center justify-content-center">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-6">

                    <!-- Mensaje de bienvenida -->
                    @if (ViewBag.UserName != null)
                    {
                        <div class="alert alert-success text-center mb-4">
                            <h4 class="mb-1">
                                <i class="fas fa-check-circle me-2"></i>Bienvenido, @ViewBag.UserName
                            </h4>
                            <p class="mb-0">Tu registro de entrada fue exitoso.</p>
                        </div>
                    }

                    <!-- Errores -->
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger mb-4">
                            <i class="fas fa-exclamation-triangle me-2"></i>@ViewBag.Error
                        </div>
                    }

                    <!-- Tarjeta principal -->
                    <div class="card shadow-lg border-0">
                        <div class="card-body p-4">

                            <h4 class="text-center mb-4">Iniciar Sesión</h4>

                            <form asp-action="Login">
                                <div class="mb-3">
                                    <label asp-for="CI" class="form-label fw-bold">Número de Carnet (CI)</label>
                                    <input asp-for="CI" type="text" class="form-control" placeholder="Ingresa tu CI">
                                </div>

                                <div class="d-grid">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-sign-in-alt me-2"></i>Ingresar
                                    </button>
                                </div>
                            </form>

                            <!-- Estado de la suscripción -->
                            <div class="mt-4 pt-3 border-top">
                                <h6 class="fw-bold text-center mb-3">Estado de la Suscripción</h6>

                                <div class="d-flex justify-content-around text-center">
                                    <span class="status-indicator status-active">
                                        <i class="fas fa-circle me-1 small"></i>Activa
                                    </span>

                                    <span class="status-indicator status-inactive">
                                        <i class="fas fa-circle me-1 small"></i>Expirada
                                    </span>

                                    <span class="status-indicator status-inactive">
                                        <i class="fas fa-circle me-1 small"></i>Pendiente
                                    </span>
                                </div>
                            </div>

                        </div>
                    </div> <!-- /card -->

                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

@if (TempData["WelcomeClient"] != null)
{
    <div id="welcomePopup" style="
            position: fixed;
            top: 20%;
            left: 50%;
            transform: translateX(-50%);
            background: #0d6efd;
            color: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 0 25px rgba(0,0,0,0.5);
            z-index: 9999;
            text-align: center;
            min-width: 330px;
        ">
        <h4 class="mb-2">Bienvenido</h4>
        <p class="mb-1"><b>@TempData["WelcomeClient"]</b></p>
        <p class="mb-1">CI: @TempData["CI"]</p>
        <p class="mb-0">Vence: @TempData["ExpireDate"]</p>
    </div>

    <script>
        setTimeout(() => {
            const popup = document.getElementById("welcomePopup");
            if (popup) popup.remove();
        }, 5000);
    </script>
}
