@model List<Platinum_Gym_System.ViewModels.SnackReportVM>

@{
    ViewData["Title"] = "Snacks Sold (Last 30 Days)";
}

<div class="container mt-4">
    <h2>Report: Snacks Sold (Last 30 Days)</h2>
    <hr />

    @if (!Model.Any())
    {
        <div class="alert alert-warning">No sales recorded.</div>
    }
    else
    {
        <table class="table table-bordered table-striped mt-3">
            <thead>
                <tr>
                    <th>Snack</th>
                    <th>Quantity Sold</th>
                    <th>Revenue (BS)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td>@item.Quantity</td>
                        <td>@string.Format("{0:N2} BS", item.Revenue)</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <a asp-controller="Reports" asp-action="Index" class="btn btn-secondary">Back</a>
</div>
