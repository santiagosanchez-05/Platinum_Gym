@model List<Platinum_Gym_System.ViewModels.PlanActiveVM>

@{
    ViewData["Title"] = "Plans and Active Members";
}

<div class="container mt-4">
    <h2>Plans and Number of Active Members</h2>
    <hr />

    @if (!Model.Any())
    {
        <div class="alert alert-warning">No plans registered.</div>
    }
    else
    {
        <table class="table table-bordered table-striped mt-3">
            <thead>
                <tr>
                    <th>Plan</th>
                    <th>Active Members</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.PlanName</td>
                        <td>@item.ActiveCount</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <a asp-controller="Reports" asp-action="Index" class="btn btn-secondary">Back</a>
</div>
